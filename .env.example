# Copy to .env.local and fill in. Never commit real values.
SITE_URL=https://www.example.com

# Public company details (empty values are hidden on the site)
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_WHATSAPP=
NEXT_PUBLIC_COMPANY_ADDRESS=

# Enquiry storage directory (defaults to ./storage)
ENQUIRY_STORE_DIR=

# SMTP for enquiry notifications (optional; enquiries are still saved without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
