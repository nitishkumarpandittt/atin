# Copy to .env.local and fill in. Never commit real values.

# MySQL 8+ connection, e.g. mysql://atin_app:YOUR_PASSWORD@localhost:3306/atin_healthcare
DATABASE_URL=mysql://atin_app:URL_ENCODED_PASSWORD@localhost:3306/atin_healthcare

# Better Auth: 32+ random characters (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
# Extra allowed origins, comma separated (e.g. https://www.example.com,https://example.com)
BETTER_AUTH_TRUSTED_ORIGINS=

SITE_URL=http://localhost:3100

# Uploaded images (defaults to ./uploads) and per-file size limit
UPLOAD_DIR=
MAX_UPLOAD_MB=5

# Public display switches, pending counsel review
SHOW_MRP_PUBLIC=false
SHOW_PRESCRIBING_SPECIALITIES=false
# Physician-facing visual aids (public/catalogue/visuals) carry indication and benefit claims;
# they stay admin-only until this is switched on.
SHOW_VISUAL_AIDS=false

# Public contact details. Optional: the registered office details are built in and the admin
# panel's Company page overrides everything here.
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_WHATSAPP=

# SMTP for enquiry notifications (optional; enquiries are always saved to the database)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# WhatsApp notifications for enquiries (optional). WHATSAPP_PROVIDER is `meta` (WhatsApp Cloud API) or
# `twilio`; blank switches it off. WHATSAPP_NOTIFY_TO: the company numbers to notify, comma separated,
# in international format (e.g. 919876543210,919812345678). Test with `npm run whatsapp:test`.
WHATSAPP_PROVIDER=
WHATSAPP_NOTIFY_TO=
# meta: Meta for Developers > your app > WhatsApp > API Setup (phone number ID and a permanent System
# User access token). Business-initiated messages must use an approved utility template, so register
# one named as below (category Utility, language English) with exactly this body:
#   New {{1}} received on the Atin HealthCare website. Name: {{2}}. Phone: {{3}}. Organisation: {{4}}. Details: {{5}}.
# {{1}} kind, {{2}} name, {{3}} phone, {{4}} organisation + city, {{5}} product / message / preferred time.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=enquiry_received
WHATSAPP_TEMPLATE_LANG=en
# twilio: Account SID and Auth Token from the Twilio console. TWILIO_WHATSAPP_FROM is the WhatsApp
# sender (sandbox: whatsapp:+14155238886). TWILIO_CONTENT_SID (optional) is an approved content
# template using the same {{1}}..{{5}} variables; without it a plain text message is sent, which only
# works in the sandbox or inside an open 24-hour session.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=
